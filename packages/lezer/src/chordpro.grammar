@top Song {
    element*
}

element {
    Line |
    Environment
    // Comment |
    // Line |
    // EmptyLine |
}

Line {
    // Text |
    // Chord |
    Metadata
    // Comment
}

/* --- Metadata --- */

Metadata {
    "{" MetadataKey directiveSeparator MetadataValue "}"
}

/* --- Environment --- */
Environment {
    "{" EnvironmentStartKey (directiveSeparator EnvironmentLabel)? "}"
    Line*
    "{" EnvironmentEndKey "}"
}

EnvironmentLabel {
    text | "label=" string
}

@tokens {
    space { $[ \t]+ }
    identifier { $[a-zA-Z_]+ }
    string { '"' (![\\"] | "\\" _)* '"' }
    text { ![}\n\r]+ }

    directiveSeparator {
        (space* ":" space* | space)
    }

    MetadataValue { text }
    MetadataKey { identifier }

    EnvironmentStartKey { "start_of_" identifier }
    EnvironmentEndKey { "end_of_" identifier }


    @precedence {
        space,
        ":",
        text,
        "label=" string
        MetadataKey,
        MetadataValue,
        EnvironmentStartKey,
        EnvironmentLabel,
        EnvironmentEndKey
    }
}
