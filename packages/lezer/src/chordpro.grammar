@top Document {
    document
}

document {
    line* finalLine?
}

line {
    (TextLine | Environment | Metadata) lineEnd | BlankLine
}

environmentLine {
    TextLine lineEnd | BlankLine
}

BlankLine {
    lineEnd
}

finalLine {
    TextLine
}

TextLine {
    (Text | Chord)+
}

Environment {
    EnvironmentStart (environmentLine* finalLine?) EnvironmentEnd
}

EnvironmentStart {
    "{" 
        EnvironmentStartKeyword 
        directiveSeparator
        environmentInfo?
    "}"
}

EnvironmentEnd {
    "{" EnvironmentEndKeyword "}"
}

environmentInfo {
    EnvironmentLabel | DirectiveAttributes
}

EnvironmentLabel {
    environmentLabelText
}

@external tokens environmentLabelTokenizer from "./tokens" {
    environmentLabelText
}

DirectiveAttributes {
    DirectiveAttribute (space DirectiveAttribute)*
}

DirectiveAttribute {
    DirectiveAttributeName "=" DirectiveAttributeValue
}

DirectiveAttributeName { 
    identifier
}

DirectiveAttributeValue { string }

EnvironmentStartKeyword {
    kw<"start_of_chorus"> |
    kw<"start_of_verse"> |
    kw<"start_of_bridge"> |
    kw<"soc"> |
    kw<"sov"> |
    kw<"sob">
//   kw<"sot"> |
//   kw<"sog">
}

EnvironmentEndKeyword {
    kw<"end_of_chorus"> |
    kw<"end_of_verse"> |
    kw<"end_of_bridge"> |
    kw<"eoc"> |
    kw<"eov"> |
    kw<"eob">
//   kw<"sot"> |
//   kw<"sog">
}

Chord {
    "[" ChordContent "]"
}

Metadata {
    "{" 
        MetadataName 
        directiveSeparator
        MetadataValue
    "}"
}

MetadataName {
    kw<"title"> |
    kw<"t"> |

    kw<"sorttitle"> |

    kw<"subtitle"> |
    kw<"st"> |

    kw<"artist"> |
    kw<"sortartist"> |
    kw<"composer"> |
    kw<"lyricist"> |
    kw<"copyright"> |
    kw<"album"> |
    kw<"year"> |

    kw<"key"> |
    kw<"time"> |
    kw<"tempo"> |
    kw<"duration"> |
    kw<"capo"> |
    kw<"tag"> |
    kw<"meta">
}

MetadataValue {
    environmentLabelText
}


directiveSeparator { (space* ":" space* | space) }



kw<keyword> {
    @specialize[@name={keyword}]<identifier, keyword>
}

@tokens {
    Text { ![{}\[\]\r\n]+ }

    ChordContent { ![\]\n\r]+ }

    space { $[ \t]+ }

    // directiveUnnamedLabel { 
    //     ![{}\[\]\r\n\t="':]
    //     ![ {}\[\]\r\n\t="':]*
    // }

    identifier {
        (@asciiLetter | "_")
        (@asciiLetter | @digit | "_")*
    }
    
    // labelNumber {
    //     @digit+
    // }

    string { "\"" (!["\\] | "\\" _)* "\"" }

    lineEnd { "\r\n" | "\n" | "\r" }

    // @precedence {
    //     directiveUnnamedLabel,
    //     identifier
    // }
}