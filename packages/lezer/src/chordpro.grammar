@top Document {
    document
}

// ----- Document ----- //

document {
    line* finalLine?
}

line {
    (TextLine | Environment | Directive) lineEnd | BlankLine
}

TextLine {
    (Text | Chord)+
}

BlankLine {
    lineEnd
}

finalLine {
    TextLine
}

// ----- Directives Type 1 - Standard ----- //

Directive {
    "{"
        DirectiveName 
        (directiveSeparator
        (DirectiveValue | Attributes))?
    "}"
}

DirectiveName {
    identifier
}

directiveSeparator { (space* ":" space* | space) }

DirectiveValue {
    directiveValueText
}

@external tokens directiveValueTokenizer from "./tokens" {
    directiveValueText
}

// ----- Directive Type 2 - Environment ----- //

Environment {
    EnvironmentStart (environmentLine* finalLine?) EnvironmentEnd
}

environmentLine {
    TextLine lineEnd | BlankLine
}

EnvironmentStart {
    "{" 
        EnvironmentStartName 
        (directiveSeparator
        (DirectiveValue | Attributes))?
    "}"
}

EnvironmentStartName {
    startOfEnvironment
}

EnvironmentEnd {
    "{" EnvironmentEndName "}"
}

EnvironmentEndName {
    endOfEnvironment
}

// ----- Attributes ----- //

Attributes {
    Attribute (space Attribute)*
}

Attribute {
    AttributeName AttributeEqual AttributeValue
}

AttributeName { identifier }

AttributeEqual { "=" }

AttributeValue { string }

// ----- Chord ----- //

Chord {
    "[" ChordContent? "]"
}

// ----- Various ----- //

string {
    "\"" StringContent? "\""
}



@tokens {
    Text { ![{}\[\]\r\n]+ }
    ChordContent { (![\]\n\r])+ }
    StringContent { (!["\\] | "\\" _)+ }
    space { $[ \t]+ }
    lineEnd { "\r\n" | "\n" | "\r" }

    identifier {
        (@asciiLetter | "_")
        (@asciiLetter | @digit | "_")*
    }

    startOfEnvironment {
        ("start_of_" | "so") identifier
    }

    endOfEnvironment {
        ("end_of_" | "eo") identifier
    }

    @precedence {
        startOfEnvironment,
        endOfEnvironment,
        identifier
    }
}

