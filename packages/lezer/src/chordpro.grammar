@top Song {
    line* finalLine?
}

// ----- Song ----- //

line {
    (TextLine | Environment | Directive) lineEnd | EmptyLine
}

TextLine {
    (Text | Chord)+
}

EmptyLine {
    lineEnd
}

finalLine {
    TextLine
}

// ----- Directives Type 1 - Standard ----- //

Directive {
    "{"
        DirectiveName 
        (directiveSeparator
        (DirectiveValue | Attributes))?
    "}"
}

DirectiveName {
    identifier
}

directiveSeparator { 
    directiveColonSeparator | directiveSpaceSeparator 
}

DirectiveValue {
    directiveValueText
}

@external tokens directiveValueTokenizer from "./tokens" {
    directiveValueText
}

// ----- Directive Type 2 - Environment ----- //

Environment {
    EnvironmentStart (environmentLine* finalLine?) EnvironmentEnd
}

environmentLine {
    (TextLine | Directive) lineEnd | EmptyLine
}

EnvironmentStart {
    "{" 
        EnvironmentStartName 
        (directiveSeparator (DirectiveValue | Attributes))?
    "}"
}

EnvironmentStartName {
    startOfEnvironment EnvironmentName
}

EnvironmentName {
    identifier
}

EnvironmentEnd {
    "{" EnvironmentEndName "}"
}

EnvironmentEndName {
    endOfEnvironment EnvironmentName
}

// ----- Attributes ----- //

Attributes {
    Attribute (space Attribute)* space?
}

Attribute {
    AttributeName AttributeEqual AttributeValue
}

AttributeName { identifier }

AttributeEqual { "=" }

AttributeValue { string }

// ----- Chord ----- //

Chord {
    "[" ChordContent? "]"
}

// ----- Various ----- //

string {
    "\"" StringContent? "\""
}



@tokens {
    Text { ![{}\[\]\r\n]+ }
    ChordContent { (![\]\n\r])+ }
    StringContent { (!["\\] | "\\" _)+ }
    space { $[ \t]+ }
    lineEnd { "\r\n" | "\n" | "\r" }

    identifier {
        (@asciiLetter | "_")
        (@asciiLetter | @digit | "_")*
    }

    startOfEnvironment {
        ("start_of_" | "so")
    }

    endOfEnvironment {
        ("end_of_" | "eo")
    }

    @precedence {
        startOfEnvironment,
        endOfEnvironment,
        identifier
    }

    directiveSpaceSeparator {
        space
    }

    directiveColonSeparator {
        space* ":" space*
    }

    @precedence {
        directiveColonSeparator,
        directiveSpaceSeparator
    }
}

