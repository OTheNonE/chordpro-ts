// ChordPro grammar for Lezer.
//
// Scope:
//   - Inline chords and annotations
//   - Metadata directives
//   - Visible comment directives
//   - Environment start/end directives and chorus recall
//   - Hash-comment lines and unknown directives for tolerant parsing
//
// The tree keeps physical LineBreak and HorizontalSpace tokens. This makes the
// source layout recoverable from node ranges without treating whitespace as a
// global skip token.

@precedence {
  directive @cut
}

@top ChordProDocument {
  (Line? LineBreak)* Line?
}

// A line is deliberately non-empty. An empty physical line is represented by a
// LineBreak without a preceding Line node.
Line {
  HashCommentLine |
  DirectiveLine |
  SongLine
}

// ChordPro processor remarks. Per the format, the hash must be the first
// character on the physical line.
HashCommentLine {
  HashCommentText
}

// A leading "{" commits the line to directive parsing. Unknown directive names
// are still accepted, so ordinary extension directives do not create errors.
DirectiveLine {
  HorizontalSpace?
  OpenBrace !directive
  HorizontalSpace?
  Directive
  CloseBrace
}

Directive {
  MetadataDirective |
  CommentDirective |
  EnvironmentDirective |
  UnknownDirective
}

// ---------------------------------------------------------------------------
// Metadata
// ---------------------------------------------------------------------------

MetadataDirective {
  ExplicitMetadataDirective |
  StandaloneMetadataDirective
}

// Examples:
//   {meta: artist The Beatles}
//   {meta custom_name: Custom value}
ExplicitMetadataDirective {
  kw<"meta">
  DirectiveSelector?
  DirectiveSeparator
  MetadataKey
  (DirectiveSeparator MetadataValue?)?
}

// Standard metadata may also be written as a directive named after the field.
// The separator and value are separate nodes, while the value remains raw so
// quoted attributes and inline markup are preserved without reinterpretation.
StandaloneMetadataDirective {
  MetadataDirectiveName
  DirectiveSelector?
  (DirectiveSeparator MetadataValue?)?
}

MetadataValue {
  directiveValue
}

MetadataDirectiveName {
  kw<"title"> |
  kw<"t"> |
  kw<"sorttitle"> |
  kw<"subtitle"> |
  kw<"st"> |
  kw<"artist"> |
  kw<"sortartist"> |
  kw<"composer"> |
  kw<"lyricist"> |
  kw<"arranger"> |
  kw<"copyright"> |
  kw<"album"> |
  kw<"year"> |
  kw<"key"> |
  kw<"time"> |
  kw<"tempo"> |
  kw<"duration"> |
  kw<"capo"> |
  kw<"tag">
}

// ---------------------------------------------------------------------------
// Visible comments
// ---------------------------------------------------------------------------

CommentDirective {
  CommentDirectiveName
  DirectiveSelector?
  (DirectiveSeparator CommentText?)?
}

CommentText {
  directiveValue
}

CommentDirectiveName {
  kw<"comment"> |
  kw<"c"> |
  kw<"comment_italic"> |
  kw<"ci"> |
  kw<"comment_box"> |
  kw<"cb"> |
  kw<"highlight">
}

// ---------------------------------------------------------------------------
// Environments / sections
// ---------------------------------------------------------------------------

EnvironmentDirective {
  EnvironmentStartDirective |
  EnvironmentEndDirective |
  ChorusRecallDirective
}

// EnvironmentStartName covers arbitrary names such as start_of_prechorus.
EnvironmentStartDirective {
  (EnvironmentStartName | EnvironmentStartShortName)
  DirectiveSelector?
  (DirectiveSeparator EnvironmentArguments?)?
}

EnvironmentStartShortName {
  kw<"soc"> |
  kw<"sov"> |
  kw<"sob"> |
  kw<"sot"> |
  kw<"sog">
}

// EnvironmentEndName covers arbitrary names such as end_of_prechorus.
EnvironmentEndDirective {
  (EnvironmentEndName | EnvironmentEndShortName)
  DirectiveSelector?
  (DirectiveSeparator EnvironmentArguments?)?
}

EnvironmentEndShortName {
  kw<"eoc"> |
  kw<"eov"> |
  kw<"eob"> |
  kw<"eot"> |
  kw<"eog">
}

// {chorus} recalls the most recently defined chorus. It is related to the
// chorus environment but is not itself an environment delimiter.
ChorusRecallDirective {
  kw<"chorus">
  DirectiveSelector?
  (DirectiveSeparator EnvironmentArguments?)?
}

EnvironmentArguments {
  directiveValue
}

// ---------------------------------------------------------------------------
// Tolerant fallback
// ---------------------------------------------------------------------------

UnknownDirective {
  DirectiveName
  DirectiveSelector?
  (DirectiveSeparator UnknownDirectiveValue?)?
}

UnknownDirectiveValue {
  directiveValue
}

// ---------------------------------------------------------------------------
// Song text, chords, and annotations
// ---------------------------------------------------------------------------

SongLine {
  SongPart+
}

SongPart {
  Annotation |
  Chord |
  SongText |
  HorizontalSpace |
  LiteralDelimiter
}

// [*Rit.] is an annotation, not a transposable chord.
Annotation {
  AnnotationOpen AnnotationContent? CloseBracket
}

Chord {
  OpenBracket ChordContent? CloseBracket
}

// Braces and unmatched closing brackets remain explicit text on non-directive
// lines. An unmatched opening bracket will naturally produce an error node,
// while still retaining its source range.
LiteralDelimiter {
  OpenBrace |
  CloseBrace |
  CloseBracket
}

// Directive names are lexed once and specialized into keyword tokens. Keeping
// MetadataKey separate prevents values such as "title" in {meta: title ...}
// from being globally reclassified as directive keywords.
kw<word> {
  @specialize[@name={word}]<DirectiveName, word>
}

@detectDelim

@tokens {
  // Physical layout. No whitespace is globally skipped.
  HorizontalSpace { $[\u0009\u0020]+ }
  LineBreak { "\r\n" | "\n" | "\r" }

  // Delimiters are named so they appear in the CST.
  OpenBrace { "{" }
  CloseBrace { "}" }
  AnnotationOpen { "[*" }
  OpenBracket { "[" }
  CloseBracket { "]" }

  // A processor comment consumes the rest of its physical line.
  HashCommentText { "#" ![\r\n]* }

  // Directive head. Conditional selectors follow the established
  // -selector / -selector! form.
  directiveNameStart { @asciiLetter | "_" }
  directiveNameChar { @asciiLetter | @digit | "_" }
  DirectiveName { directiveNameStart directiveNameChar* }
  DirectiveSelector { "-" directiveNameChar+ "!"? }

  // Long-form environment names are kept as a single token. Consumers can
  // obtain the environment name by removing start_of_ / end_of_ from the
  // token's source slice.
  environmentName { directiveNameChar+ }
  EnvironmentStartName { "start_of_" environmentName }
  EnvironmentEndName { "end_of_" environmentName }

  // Separators are explicit CST nodes, preserving whether a directive used a
  // colon, whitespace, or both. Values may contain quoted attributes and
  // markup; only the directive-closing brace or physical line ending ends one.
  DirectiveSeparator {
    $[\u0009\u0020]* ":" $[\u0009\u0020]* |
    $[\u0009\u0020]+
  }
  MetadataKey { directiveNameStart directiveNameChar* }
  directiveValue { ![}\r\n]+ }

  // Song-level text is split around whitespace and ChordPro delimiters. This
  // preserves all visible text while keeping chord/directive punctuation in
  // the tree.
  SongText { ![\u0009\u0020\u005b\u005d\u007b\u007d\r\n]+ }
  AnnotationContent { ![\u005d\r\n]+ }
  ChordContent { ![\u005d\r\n]+ }

  @precedence {
    AnnotationOpen,
    OpenBracket
  }

  @precedence {
    EnvironmentStartName,
    EnvironmentEndName,
    DirectiveName
  }

  @precedence {
    HashCommentText,
    SongText
  }
}
